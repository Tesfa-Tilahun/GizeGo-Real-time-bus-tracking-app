PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/gizego
JWT_SECRET="d82db07a4c551057fbd64477485e33adea6abfc66c1ed48291203f6bd550e26532b350b878b759cf1652a4ef95712d6e9ca8ae052e319b16155caf991212de11"
JWT_EXPIRES_IN=7d
# No trailing slash. On Render, set to https://your-service.onrender.com
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated **Web + Android + iOS** OAuth 2.0 Client IDs from Google Cloud Console.
# Tokens from Expo/Google use whichever client initiated the login; missing an ID breaks verification with JWT "audience" errors.
# Example: xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com,zzz.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_IDS=
# Optional: Google Cloud Translation API key → public endpoint POST /api/v1/public/translate (body: { "texts": ["..."], "target": "am"|"en", "source": "en"|"am" }).
# Console: enable "Cloud Translation API" → Credentials → API key (restrict to Translation API).
GOOGLE_CLOUD_TRANSLATIONS_API_KEY=
# Dev only: JSON from POST /auth/forgot-password includes devResetToken for mobile testing
PASSWORD_RESET_RETURN_TOKEN=false

# Optional: on API startup (after migrations), create this user as admin or promote existing email + reset password.
# Password must be at least 6 characters. Omit both in production unless you intentionally want repeatable bootstrap.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=

# Password reset emails (Nodemailer). Required for forgot-password to deliver the code by email.
# ForgotPassword checks: SMTP_HOST, SMTP_USER, SMTP_PASSWORD (MAIL_FROM defaults if omitted).
#
# Gmail: enable 2-Step Verification → Google Account → Security → App passwords → generate one.
# Use port 587 + SMTP_SECURE=false. MAIL_FROM display name must use the same mailbox as SMTP_USER for Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM="GizeGo <you@gmail.com>"
#
# Port 465 SSL: SMTP_PORT=465 and SMTP_SECURE=true
#
# Microsoft 365 (typical): SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
#
# Sandbox (no real inbox): Mailtrap SMTP credentials from their dashboard
