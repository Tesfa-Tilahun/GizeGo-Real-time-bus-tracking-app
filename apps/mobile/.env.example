# Backend URL reachable from your phone/emulator:
# Emulator Android: http://10.0.2.2:3000 → host machine localhost
# Real device + PC on LAN: http://YOUR_PC_IP:3000 (Windows Firewall allow 3000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Google OAuth (same project as APIs & Services → Credentials) ─────────────────
#
# Backend must set GOOGLE_OAUTH_CLIENT_IDS to the SAME comma-separated IDs (Web + Android + iOS).
#
# 1. Web application client → Authorized redirect URIs include:
#    gizego://oauthredirect
#    (Expo Go / dev client; scheme matches app.json "scheme")
#
# 2. iOS client → Bundle ID must match app.json/ios.bundleIdentifier (default com.gizego.mobile).
#
# 3. Android client → Package name com.gizego.mobile + debug/release SHA-1 fingerprints
#    (Android Studio Gradle signing report or keytool ~/.android/debug.keystore).
#
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# English / አማርኛ: open the side menu and choose English or አማርኛ (saved on device).
# Optional API: GOOGLE_CLOUD_TRANSLATIONS_API_KEY enables POST /api/v1/public/translate for Google-powered en↔am of custom text.
